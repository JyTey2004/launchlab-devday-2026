# Local prototype only. Keep operator and preview on different origins.
PORT=4310
PREVIEW_PORT=4311
# Absolute directory optional; defaults to .data in this repository.
# LAUNCHLAB_DATA_DIR=/path/to/private/data
# Optional token for agents calling the HTTP management API.
# LAUNCHLAB_API_TOKEN=generate-a-long-random-secret
# Optional read-only credential for local deployment inspection of an authorized GitHub repo.
# Configure privately; never submit a token through an agent prompt or the inspection API.
# LAUNCHLAB_GITHUB_TOKEN=

# Optional bounded readiness seller. Free by default; no live billing configured.
SELLER_PORT=4312
SELLER_MODE=free
PAYMENT_NETWORK=eip155:1952
READINESS_PRICE=$0.01
# PAY_TO_ADDRESS=your-receiving-wallet-address
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
# Real managed hosting is opt-in and requires an operator API token.
LAUNCHLAB_MANAGED_ENABLED=false
LAUNCHLAB_MANAGED_CONFIG=deploy/managed-hosting.json

# Server-only OpenAI key. Put the value in the ignored .env, never frontend/VITE_ variables.
OPENAI_API_KEY=
LAUNCHLAB_OPENAI_MODEL=gpt-5.4-2026-03-05
